<file path="components/sections/LeadCaptureForm.tsx">
'use client';

import React, { useState } from 'react';
import { usePathname } from 'next/navigation';
import { Send, CheckCircle2, AlertCircle, Loader2, ArrowRight } from 'lucide-react';
import { SERVICE_OPTIONS, BUDGET_TIERS, SITE_CONFIG } from '@/lib/constants';
import { ServiceCategory, BudgetTier } from '@/types/lead';

interface FormDataState {
  fullName: string;
  email: string;
  phone: string;
  service: ServiceCategory;
  monthlyBudget: BudgetTier;
  message: string;
  website_url: string;
}

interface LeadCaptureFormProps {
  title?: string;
  subtitle?: string;
  className?: string;
}

export default function LeadCaptureForm({
  title = 'Book a Direct Growth Consultation',
  subtitle = 'Direct execution with Vraj Vithalani. No account managers, no junior handoffs. 24-hour response SLA.',
  className = '',
}: LeadCaptureFormProps) {
  const pathname = usePathname();

  const [formData, setFormData] = useState<FormDataState>({
    fullName: '',
    email: '',
    phone: '',
    service: 'Google Ads Management',
    monthlyBudget: '< ₹15,000/mo',
    message: '',
    website_url: '',
  });

  const [loading, setLoading] = useState(false);
  const [success, setSuccess] = useState(false);
  const [error, setError] = useState<string | null>(null);

  async function handleSubmit(e: React.FormEvent) {
    e.preventDefault();
    setLoading(true);
    setError(null);

    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          ...formData,
          pageSource: pathname || '/',
        }),
      });

      const data = await res.json();

      if (!res.ok || !data.success) {
        throw new Error(data.error?.message || 'Failed to submit inquiry.');
      }

      setSuccess(true);
    } catch (err: unknown) {
      if (err instanceof Error) {
        setError(err.message);
      } else {
        setError('An unexpected error occurred. Please reach out via WhatsApp directly.');
      }
    } finally {
      setLoading(false);
    }
  }

  if (success) {
    return (
      <div
        id="lead-capture"
        className={`glass-card rounded-3xl p-8 sm:p-12 border border-emerald-200 bg-emerald-50/40 text-center max-w-2xl mx-auto shadow-glass ${className}`}
      >
        <div className="w-14 h-14 rounded-2xl bg-emerald-500 text-white flex items-center justify-center mx-auto mb-4 shadow-lg shadow-emerald-500/20">
          <CheckCircle2 className="w-7 h-7" />
        </div>
        <h3 className="text-2xl font-bold text-ink">Inquiry Received Successfully</h3>
        <p className="text-sm text-ink-muted mt-2 max-w-md mx-auto">
          Thank you for reaching out. I review all inquiries personally and will get back to you within 24 hours.
        </p>

        <div className="mt-6 pt-6 border-t border-emerald-200/60 flex flex-col sm:flex-row items-center justify-center gap-3">
          <a
            href={SITE_CONFIG.whatsappUrl}
            target="_blank"
            rel="noreferrer"
            className="w-full sm:w-auto py-2.5 px-5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-semibold text-xs transition flex items-center justify-center gap-2 shadow-sm"
          >
            <span>Need an instant reply? WhatsApp Direct</span>
            <ArrowRight className="w-3.5 h-3.5" />
          </a>
        </div>
      </div>
    );
  }

  return (
    <div
      id="lead-capture"
      className={`glass-card rounded-3xl p-6 sm:p-10 border border-neutral-200/90 bg-white/95 shadow-glass max-w-3xl mx-auto ${className}`}
    >
      <div className="text-center max-w-xl mx-auto mb-8">
        <span className="text-xs font-bold uppercase tracking-wider text-brand-teal-dark bg-brand-teal-tint px-3 py-1 rounded-full border border-brand-teal-border">
          Direct Specialist Access
        </span>
        <h2 className="text-2xl sm:text-3xl font-extrabold tracking-tight text-ink mt-3">
          {title}
        </h2>
        <p className="text-xs sm:text-sm text-ink-muted mt-2">{subtitle}</p>
      </div>

      {error && (
        <div className="mb-6 p-4 rounded-xl bg-red-50 border border-red-200/80 flex items-start gap-3 text-red-700 text-xs sm:text-sm">
          <AlertCircle className="w-5 h-5 shrink-0 mt-0.5" />
          <span>{error}</span>
        </div>
      )}

      <form onSubmit={handleSubmit} className="space-y-5">
        {/* Invisible Spambot Honeypot */}
        <input
          type="text"
          name="website_url"
          value={formData.website_url}
          onChange={(e) => setFormData({ ...formData, website_url: e.target.value })}
          tabIndex={-1}
          autoComplete="off"
          style={{ display: 'none', position: 'absolute', left: '-9999px' }}
        />

        <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label className="block text-xs font-semibold uppercase tracking-wider text-ink-muted mb-1.5">
              Full Name *
            </label>
            <input
              type="text"
              required
              value={formData.fullName}
              onChange={(e) => setFormData({ ...formData, fullName: e.target.value })}
              placeholder="e.g. Rahul Sharma"
              className="w-full px-3.5 py-2.5 rounded-xl border border-neutral-200 bg-white text-ink text-sm focus:border-brand-teal focus:ring-2 focus:ring-brand-teal/20 outline-none transition"
            />
          </div>

          <div>
            <label className="block text-xs font-semibold uppercase tracking-wider text-ink-muted mb-1.5">
              Work Email *
            </label>
            <input
              type="email"
              required
              value={formData.email}
              onChange={(e) => setFormData({ ...formData, email: e.target.value })}
              placeholder="rahul@company.com"
              className="w-full px-3.5 py-2.5 rounded-xl border border-neutral-200 bg-white text-ink text-sm focus:border-brand-teal focus:ring-2 focus:ring-brand-teal/20 outline-none transition"
            />
          </div>
        </div>

        <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label className="block text-xs font-semibold uppercase tracking-wider text-ink-muted mb-1.5">
              Phone / WhatsApp Number *
            </label>
            <input
              type="tel"
              required
              value={formData.phone}
              onChange={(e) => setFormData({ ...formData, phone: e.target.value })}
              placeholder="+91 99000 00000"
              className="w-full px-3.5 py-2.5 rounded-xl border border-neutral-200 bg-white text-ink text-sm focus:border-brand-teal focus:ring-2 focus:ring-brand-teal/20 outline-none transition"
            />
          </div>

          <div>
            <label className="block text-xs font-semibold uppercase tracking-wider text-ink-muted mb-1.5">
              Service Focus *
            </label>
            <select
              value={formData.service}
              onChange={(e) =>
                setFormData({
                  ...formData,
                  service: e.target.value as ServiceCategory,
                })
              }
              className="w-full px-3.5 py-2.5 rounded-xl border border-neutral-200 bg-white text-ink text-sm focus:border-brand-teal focus:ring-2 focus:ring-brand-teal/20 outline-none transition font-medium"
            >
              {SERVICE_OPTIONS.map((svc) => (
                <option key={svc} value={svc}>
                  {svc}
                </option>
              ))}
            </select>
          </div>
        </div>

        <div>
          <label className="block text-xs font-semibold uppercase tracking-wider text-ink-muted mb-1.5">
            Target Monthly Budget *
          </label>
          <select
            value={formData.monthlyBudget}
            onChange={(e) =>
              setFormData({
                ...formData,
                monthlyBudget: e.target.value as BudgetTier,
              })
            }
            className="w-full px-3.5 py-2.5 rounded-xl border border-neutral-200 bg-white text-ink text-sm focus:border-brand-teal focus:ring-2 focus:ring-brand-teal/20 outline-none transition font-medium"
          >
            {BUDGET_TIERS.map((tier) => (
              <option key={tier} value={tier}>
                {tier}
              </option>
            ))}
          </select>
        </div>

        <div>
          <label className="block text-xs font-semibold uppercase tracking-wider text-ink-muted mb-1.5">
            Project Overview &amp; Goals (Optional)
          </label>
          <textarea
            rows={3}
            value={formData.message}
            onChange={(e) => setFormData({ ...formData, message: e.target.value })}
            placeholder="Tell me about your current revenue bottlenecks, ad spend, or technical requirements..."
            className="w-full p-3 rounded-xl border border-neutral-200 bg-white text-ink text-sm focus:border-brand-teal focus:ring-2 focus:ring-brand-teal/20 outline-none transition"
          />
        </div>

        <button
          type="submit"
          disabled={loading}
          className="w-full py-3.5 px-6 rounded-xl bg-ink hover:bg-neutral-800 text-white font-bold text-sm transition flex items-center justify-center gap-2 shadow-sm disabled:opacity-50"
        >
          {loading ? (
            <>
              <Loader2 className="w-4 h-4 animate-spin" />
              <span>Submitting Inquiry...</span>
            </>
          ) : (
            <>
              <Send className="w-4 h-4" />
              <span>Request Growth Consultation</span>
            </>
          )}
        </button>

        <p className="text-center text-[11px] text-ink-subtle">
          100% direct engagement with Vraj Vithalani &bull; Privacy protected under DPDP Act 2023
        </p>
      </form>
    </div>
  );
}
