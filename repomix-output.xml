import mongoose from 'mongoose';
import bcrypt from 'bcryptjs';

const MONGODB_URI = process.env.MONGODB_URI || 'mongodb://127.0.0.1:27017/vrajvithalani_dev';
console.log(MONGODB_URI)
// Admin User Minimal Schema for Seeding
const AdminUserSchema = new mongoose.Schema({
  username: { type: String, required: true, unique: true },
  email: { type: String, required: true, unique: true },
  passwordHash: { type: String, required: true },
  role: { type: String, default: 'superadmin' },
  tokenVersion: { type: Number, default: 0 },
});

// Settings Minimal Schema for Seeding
const SettingsSchema = new mongoose.Schema({
  gtmContainerId: { type: String, default: '' },
  gaMeasurementId: { type: String, default: '' },
  metaPixelId: { type: String, default: '' },
  customHeadScripts: { type: String, default: '' },
  customBodyScripts: { type: String, default: '' },
  isGtmEnabled: { type: Boolean, default: true },
  isGaEnabled: { type: Boolean, default: true },
  isMetaPixelEnabled: { type: Boolean, default: true },
  updatedBy: { type: String, default: 'seed_script' },
});

async function seed() {
  console.log('Connecting to database...');
  await mongoose.connect(MONGODB_URI);
  console.log('Connected.');

  const AdminUser = mongoose.models.AdminUser || mongoose.model('AdminUser', AdminUserSchema);
  const Settings = mongoose.models.Settings || mongoose.model('Settings', SettingsSchema);

  // 1. Seed Superadmin User
  const defaultUsername = process.env.ADMIN_USERNAME || 'admin';
  const defaultEmail = 'vrajvithalani00@gmail.com';
  const defaultPassword = process.env.ADMIN_PASSWORD || '#Vithalani@Vraj@02614790';

  const existingAdmin = await AdminUser.findOne({
    $or: [{ username: defaultUsername }, { email: defaultEmail }],
  });

  if (!existingAdmin) {
    const passwordHash = await bcrypt.hash(defaultPassword, 12);
    await AdminUser.create({
      username: defaultUsername,
      email: defaultEmail,
      passwordHash,
      role: 'superadmin',
      tokenVersion: 0,
    });
    console.log(`✅ Superadmin created: ${defaultUsername} (${defaultEmail})`);
    console.log(`⚠️ Default temporary password: ${defaultPassword}`);
  } else {
    console.log(`ℹ️ Admin user already exists (${existingAdmin.username})`);
  }

  // 2. Seed Singleton Settings Document
  const existingSettings = await Settings.findOne();
  if (!existingSettings) {
    await Settings.create({
      gtmContainerId: process.env.NEXT_PUBLIC_GTM_ID || '',
      gaMeasurementId: process.env.NEXT_PUBLIC_GA_ID || '',
      metaPixelId: process.env.NEXT_PUBLIC_META_PIXEL_ID || '',
      customHeadScripts: '',
      customBodyScripts: '',
      isGtmEnabled: true,
      isGaEnabled: true,
      isMetaPixelEnabled: true,
      updatedBy: 'system_init',
    });
    console.log('✅ Default tracking & analytics settings document created.');
  } else {
    console.log('ℹ️ Settings document already initialized.');
  }

  console.log('Database seeding complete.');
  await mongoose.disconnect();
  process.exit(0);
}

seed().catch((err) => {
  console.error('Seeding failed:', err);
  process.exit(1);
});
