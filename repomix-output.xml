import { NextRequest, NextResponse } from 'next/server';
import { connectToDatabase } from '@/lib/db';
import { Media } from '@/models/Media';
import { deleteFromCloudinary } from '@/lib/cloudinary';

export async function DELETE(
  _req: NextRequest,
  { params }: { params: Promise<{ id: string }> }
) {
  try {
    const { id } = await params;
    await connectToDatabase();

    const asset = await Media.findById(id);
    if (!asset) {
      return NextResponse.json(
        { success: false, error: { code: 'NOT_FOUND', message: 'Asset not found' } },
        { status: 404 }
      );
    }

    // Delete from Cloudinary
    await deleteFromCloudinary(asset.publicId);

    // Delete from MongoDB
    await Media.findByIdAndDelete(id);

    return NextResponse.json({
      success: true,
      message: 'Media asset deleted permanently from CDN and database',
    });
  } catch (error) {
    console.error('Media delete error:', error);
    return NextResponse.json(
      { success: false, error: { code: 'SERVER_ERROR', message: 'Failed to delete media asset' } },
      { status: 500 }
    );
  }
}
