<file path="app/iamadmin/media/page.tsx">
'use client';

import React, { useState, useEffect } from 'react';
import Image from 'next/image';
import { Upload, Trash2, Copy, Check, Loader2, Image as ImageIcon } from 'lucide-react';
import { IMediaAsset } from '@/types/media';

export default function AdminMediaPage() {
  const [mediaList, setMediaList] = useState<IMediaAsset[]>([]);
  const [loading, setLoading] = useState(true);
  const [uploading, setUploading] = useState(false);
  const [selectedFile, setSelectedFile] = useState<File | null>(null);
  const [altText, setAltText] = useState('');
  const [caption, setCaption] = useState('');
  const [copiedId, setCopiedId] = useState<string | null>(null);

  async function loadMedia() {
    setLoading(true);
    try {
      const res = await fetch('/api/admin/media');
      const data = await res.json();
      if (data.success) {
        setMediaList(data.data);
      }
    } catch (err) {
      console.error('Failed to load media:', err);
    } finally {
      setLoading(false);
    }
  }

  useEffect(() => {
    loadMedia();
  }, []);

  async function handleUpload(e: React.FormEvent) {
    e.preventDefault();
    if (!selectedFile || !altText.trim()) return;

    setUploading(true);
    const formData = new FormData();
    formData.append('file', selectedFile);
    formData.append('altText', altText.trim());
    formData.append('caption', caption.trim());

    try {
      const res = await fetch('/api/admin/media', {
        method: 'POST',
        body: formData,
      });
      const data = await res.json();
      if (data.success) {
        setSelectedFile(null);
        setAltText('');
        setCaption('');
        loadMedia();
      }
    } catch (err) {
      console.error('Upload failed:', err);
    } finally {
      setUploading(false);
    }
  }

  async function handleDelete(id: string) {
    if (!confirm('Are you sure you want to permanently delete this media asset?')) return;
    try {
      const res = await fetch(`/api/admin/media/${id}`, { method: 'DELETE' });
      const data = await res.json();
      if (data.success) {
        setMediaList((prev) => prev.filter((m) => m._id !== id));
      }
    } catch (err) {
      console.error('Delete failed:', err);
    }
  }

  function handleCopy(url: string, id: string) {
    navigator.clipboard.writeText(url);
    setCopiedId(id);
    setTimeout(() => setCopiedId(null), 2000);
  }

  return (
    <div className="space-y-6">
      <div>
        <h1 className="text-2xl font-bold tracking-tight text-ink">Cloudinary Media Vault</h1>
        <p className="text-sm text-ink-muted">
          Manage production WebP/AVIF imagery with mandatory accessibility alt-text.
        </p>
      </div>

      {/* Upload Box */}
      <form
        onSubmit={handleUpload}
        className="glass-card rounded-2xl p-6 border border-neutral-200/80 bg-white space-y-4"
      >
        <h2 className="text-sm font-bold text-ink">Upload Production Asset</h2>

        <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
          <div>
            <label className="block text-xs font-semibold text-ink-muted uppercase tracking-wider mb-2">
              Select Image File
            </label>
            <input
              type="file"
              accept="image/png,image/jpeg,image/webp,image/svg+xml"
              required
              onChange={(e) => setSelectedFile(e.target.files?.[0] || null)}
              className="w-full text-xs text-ink-muted file:mr-3 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-medium file:bg-brand-teal-tint file:text-brand-teal-dark hover:file:bg-brand-teal hover:file:text-white transition"
            />
          </div>

          <div>
            <label className="block text-xs font-semibold text-ink-muted uppercase tracking-wider mb-2">
              Accessibility Alt Text *
            </label>
            <input
              type="text"
              required
              value={altText}
              onChange={(e) => setAltText(e.target.value)}
              placeholder="Descriptive alt text for SEO"
              className="w-full px-3 py-2 rounded-xl border border-neutral-200 text-xs text-ink focus:border-brand-teal outline-none"
            />
          </div>

          <div>
            <label className="block text-xs font-semibold text-ink-muted uppercase tracking-wider mb-2">
              Caption (Optional)
            </label>
            <input
              type="text"
              value={caption}
              onChange={(e) => setCaption(e.target.value)}
              placeholder="Visual caption"
              className="w-full px-3 py-2 rounded-xl border border-neutral-200 text-xs text-ink focus:border-brand-teal outline-none"
            />
          </div>
        </div>

        <button
          type="submit"
          disabled={uploading || !selectedFile || !altText.trim()}
          className="py-2.5 px-5 rounded-xl bg-ink hover:bg-neutral-800 text-white font-medium text-xs transition flex items-center gap-2 disabled:opacity-50"
        >
          {uploading ? (
            <>
              <Loader2 className="w-4 h-4 animate-spin" />
              <span>Uploading to CDN...</span>
            </>
          ) : (
            <>
              <Upload className="w-4 h-4" />
              <span>Upload to Cloudinary</span>
            </>
          )}
        </button>
      </form>

      {/* Media Grid */}
      {loading ? (
        <div className="py-20 flex flex-col items-center justify-center text-ink-muted gap-2">
          <Loader2 className="w-6 h-6 animate-spin text-brand-teal" />
          <span className="text-xs">Loading media vault...</span>
        </div>
      ) : mediaList.length === 0 ? (
        <div className="glass-card rounded-2xl p-12 text-center text-ink-muted">
          <ImageIcon className="w-10 h-10 mx-auto mb-3 text-neutral-300" />
          <p className="text-sm font-medium">No assets uploaded yet.</p>
        </div>
      ) : (
        <div className="grid grid-cols-2 md:grid-cols-4 gap-4">
          {mediaList.map((asset) => (
            <div
              key={asset._id}
              className="glass-card rounded-xl overflow-hidden border border-neutral-200/80 bg-white group flex flex-col justify-between"
            >
              <div className="relative aspect-video bg-neutral-100 overflow-hidden">
                <Image
                  src={asset.secureUrl}
                  alt={asset.altText}
                  fill
                  className="object-cover group-hover:scale-105 transition duration-300"
                  sizes="(max-width: 768px) 50vw, 25vw"
                />
              </div>

              <div className="p-3 space-y-2">
                <p className="text-xs font-semibold text-ink truncate" title={asset.altText}>
                  {asset.altText}
                </p>
                <div className="flex items-center justify-between text-[10px] text-ink-subtle">
                  <span>{asset.width}x{asset.height}</span>
                  <span>{(asset.bytes / 1024).toFixed(0)} KB</span>
                </div>

                <div className="flex items-center gap-1.5 pt-2 border-t border-neutral-100">
                  <button
                    onClick={() => handleCopy(asset.secureUrl, asset._id)}
                    className="flex-1 py-1.5 px-2 rounded-lg bg-neutral-100 hover:bg-neutral-200 text-ink text-[11px] font-medium flex items-center justify-center gap-1 transition"
                  >
                    {copiedId === asset._id ? (
                      <>
                        <Check className="w-3 h-3 text-emerald-600" />
                        <span>Copied</span>
                      </>
                    ) : (
                      <>
                        <Copy className="w-3 h-3" />
                        <span>Copy URL</span>
                      </>
                    )}
                  </button>

                  <button
                    onClick={() => handleDelete(asset._id)}
                    className="p-1.5 rounded-lg text-red-500 hover:bg-red-50 hover:text-red-700 transition"
                    title="Delete asset"
                  >
                    <Trash2 className="w-3.5 h-3.5" />
                  </button>
                </div>
              </div>
            </div>
          ))}
        </div>
      )}
    </div>
  );
}
</file>

<file path="app/iamadmin/settings/page.tsx">
'use client';

import React, { useState, useEffect } from 'react';
import { Save, CheckCircle2, AlertCircle, Loader2 } from 'lucide-react';
import { ISettings } from '@/types/settings';

export default function AdminSettingsPage() {
  const [settings, setSettings] = useState<ISettings>({
    gtmContainerId: '',
    gaMeasurementId: '',
    metaPixelId: '',
    customHeadScripts: '',
    customBodyScripts: '',
    isGtmEnabled: true,
    isGaEnabled: true,
    isMetaPixelEnabled: true,
  });

  const [loading, setLoading] = useState(true);
  const [saving, setSaving] = useState(false);
  const [statusMsg, setStatusMsg] = useState<{ type: 'success' | 'error'; text: string } | null>(
    null
  );

  useEffect(() => {
    async function loadSettings() {
      try {
        const res = await fetch('/api/admin/settings');
        const data = await res.json();
        if (data.success && data.data) {
          setSettings(data.data);
        }
      } catch (err) {
        console.error('Failed to load settings:', err);
      } finally {
        setLoading(false);
      }
    }
    loadSettings();
  }, []);

  async function handleSave(e: React.FormEvent) {
    e.preventDefault();
    setSaving(true);
    setStatusMsg(null);

    try {
      const res = await fetch('/api/admin/settings', {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(settings),
      });
      const data = await res.json();

      if (!res.ok || !data.success) {
        throw new Error(data.error?.message || 'Failed to save settings');
      }

      setStatusMsg({ type: 'success', text: 'Tracking & Script settings updated successfully!' });
    } catch (err: unknown) {
      if (err instanceof Error) {
        setStatusMsg({ type: 'error', text: err.message });
      } else {
        setStatusMsg({ type: 'error', text: 'An unexpected error occurred.' });
      }
    } finally {
      setSaving(false);
    }
  }

  if (loading) {
    return (
      <div className="py-20 flex flex-col items-center justify-center text-ink-muted gap-2">
        <Loader2 className="w-6 h-6 animate-spin text-brand-teal" />
        <span className="text-xs">Loading analytics configuration...</span>
      </div>
    );
  }

  return (
    <div className="max-w-4xl space-y-6">
      <div>
        <h1 className="text-2xl font-bold tracking-tight text-ink">Analytics & Tracking Engine</h1>
        <p className="text-sm text-ink-muted">
          Manage GTM, GA4, Meta Pixel, and custom scripts runtime without redeploying code.
        </p>
      </div>

      {statusMsg && (
        <div
          className={`p-4 rounded-xl flex items-center gap-3 text-sm border ${
            statusMsg.type === 'success'
              ? 'bg-emerald-50 text-emerald-800 border-emerald-200'
              : 'bg-red-50 text-red-800 border-red-200'
          }`}
        >
          {statusMsg.type === 'success' ? (
            <CheckCircle2 className="w-5 h-5 shrink-0 text-emerald-600" />
          ) : (
            <AlertCircle className="w-5 h-5 shrink-0 text-red-600" />
          )}
          <span>{statusMsg.text}</span>
        </div>
      )}

      <form onSubmit={handleSave} className="space-y-6">
        {/* Container IDs Card */}
        <div className="glass-card rounded-2xl p-6 border border-neutral-200/80 bg-white space-y-5">
          <h2 className="text-base font-bold text-ink border-b border-neutral-100 pb-3">
            Core Tracking Containers
          </h2>

          <div className="grid grid-cols-1 md:grid-cols-3 gap-5">
            <div>
              <label className="block text-xs font-semibold text-ink-muted uppercase tracking-wider mb-2">
                Google Tag Manager ID
              </label>
              <input
                type="text"
                value={settings.gtmContainerId}
                onChange={(e) => setSettings({ ...settings, gtmContainerId: e.target.value })}
                placeholder="GTM-XXXXXXX"
                className="w-full px-3.5 py-2.5 rounded-xl border border-neutral-200 bg-white text-xs font-mono text-ink focus:border-brand-teal focus:ring-2 focus:ring-brand-teal/20 outline-none"
              />
            </div>

            <div>
              <label className="block text-xs font-semibold text-ink-muted uppercase tracking-wider mb-2">
                Google Analytics 4 ID
              </label>
              <input
                type="text"
                value={settings.gaMeasurementId}
                onChange={(e) => setSettings({ ...settings, gaMeasurementId: e.target.value })}
                placeholder="G-XXXXXXXXXX"
                className="w-full px-3.5 py-2.5 rounded-xl border border-neutral-200 bg-white text-xs font-mono text-ink focus:border-brand-teal focus:ring-2 focus:ring-brand-teal/20 outline-none"
              />
            </div>

            <div>
              <label className="block text-xs font-semibold text-ink-muted uppercase tracking-wider mb-2">
                Meta Pixel ID
              </label>
              <input
                type="text"
                value={settings.metaPixelId}
                onChange={(e) => setSettings({ ...settings, metaPixelId: e.target.value })}
