<file path="components/sections/RoiCalculator.tsx">
'use client';

import React, { useState, useId } from 'react';
import { Calculator, ArrowRight, MessageSquare, TrendingUp } from 'lucide-react';
import { SITE_CONFIG } from '@/lib/constants';

interface RoiCalculatorProps {
  className?: string;
}

export function RoiCalculator({ className = '' }: RoiCalculatorProps) {
  const budgetInputId = useId();
  const [budget, setBudget] = useState<number>(50000);

  // Exact formulas from Doc 07
  // CPC = ₹28.17 | Conversion to Lead = 5.0% | Lead to Deal = 20.0%
  const avgCpc = 28.17;
  const clicks = Math.round(budget / avgCpc);
  const leads = Math.max(1, Math.round(clicks * 0.05));
  const deals = Math.max(1, Math.round(leads * 0.2));
  const estimatedRevenue = deals * 45000; // Estimated avg deal value
  const estimatedRoas = (estimatedRevenue / budget).toFixed(1);

  const formattedBudget = new Intl.NumberFormat('en-IN', {
    style: 'currency',
    currency: 'INR',
    maximumFractionDigits: 0,
  }).format(budget);

  const whatsappMessage = encodeURIComponent(
    `Hi Vraj, I calculated my Google Ads ROI on your website with a monthly budget of ${formattedBudget} (Estimated ~${leads} leads). I would like to discuss campaign scaling.`
  );

  return (
    <div
      id="roi-calculator"
      className={`glass-card rounded-3xl p-6 sm:p-10 border border-neutral-200/90 bg-white/95 shadow-glass ${className}`}
    >
      <div className="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
        <div>
          <div className="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-brand-teal-dark bg-brand-teal-tint px-3 py-1 rounded-full border border-brand-teal-border mb-2">
            <Calculator className="w-3.5 h-3.5" />
            <span>Interactive Modeling</span>
          </div>
          <h2 className="text-2xl sm:text-3xl font-extrabold tracking-tight text-ink">
            Google Ads Budget &amp; ROI Simulator
          </h2>
          <p className="text-xs sm:text-sm text-ink-muted mt-1">
            Simulate clicks, qualified inquiries, and revenue projection based on proven campaign benchmarks.
          </p>
        </div>

        <div className="text-right shrink-0">
          <span className="text-xs text-ink-subtle uppercase tracking-wider block">Target Monthly Budget</span>
          <span className="text-2xl sm:text-3xl font-mono font-extrabold text-brand-teal-dark">
            {formattedBudget}
          </span>
        </div>
      </div>

      {/* Slider Control */}
      <div className="space-y-4 mb-8">
        <label htmlFor={budgetInputId} className="sr-only">Monthly Ad Budget</label>
        <input
          id={budgetInputId}
          type="range"
          min={15000}
          max={500000}
          step={5000}
          value={budget}
          onChange={(e) => setBudget(Number(e.target.value))}
          className="w-full h-2.5 bg-neutral-200 rounded-lg appearance-none cursor-pointer accent-brand-teal"
        />
        <div className="flex justify-between text-[11px] font-mono text-ink-subtle">
          <span>₹15,000/mo</span>
          <span>₹1,00,000/mo</span>
          <span>₹2,50,000/mo</span>
          <span>₹5,00,000+/mo</span>
        </div>
      </div>

      {/* Projection Metric Grid */}
      <div className="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
        <div className="p-4 rounded-2xl bg-canvas-soft border border-neutral-200/80">
          <span className="text-[11px] text-ink-subtle font-medium block mb-1">Target Clicks</span>
          <span className="text-xl sm:text-2xl font-mono font-bold text-ink">
            ~{clicks.toLocaleString()}
          </span>
          <span className="text-[10px] text-ink-muted block mt-1">Avg CPC ~₹28.17</span>
        </div>

        <div className="p-4 rounded-2xl bg-canvas-soft border border-neutral-200/80">
          <span className="text-[11px] text-ink-subtle font-medium block mb-1">Est. Qualified Leads</span>
          <span className="text-xl sm:text-2xl font-mono font-bold text-brand-teal-dark">
            ~{leads} Leads
          </span>
          <span className="text-[10px] text-ink-muted block mt-1">5.0% CVR benchmark</span>
        </div>

        <div className="p-4 rounded-2xl bg-canvas-soft border border-neutral-200/80">
          <span className="text-[11px] text-ink-subtle font-medium block mb-1">Closed Deals</span>
          <span className="text-xl sm:text-2xl font-mono font-bold text-ink">
            ~{deals} Clients
          </span>
          <span className="text-[10px] text-ink-muted block mt-1">20% Close rate</span>
        </div>

        <div className="p-4 rounded-2xl bg-brand-teal-tint border border-brand-teal-border">
          <span className="text-[11px] text-brand-teal-dark font-medium mb-1 flex items-center gap-1">
            <TrendingUp className="w-3 h-3" /> Projected Return
          </span>
          <span className="text-xl sm:text-2xl font-mono font-extrabold text-brand-teal-dark">
            {estimatedRoas}x ROAS
          </span>
          <span className="text-[10px] text-brand-teal-dark block mt-1">Calculated Pipeline</span>
        </div>
      </div>

      {/* Action Trigger */}
      <div className="flex flex-col sm:flex-row items-center justify-between gap-4 p-4 rounded-2xl bg-ink text-white">
        <div>
          <span className="font-semibold text-sm block">Ready to scale this budget?</span>
          <span className="text-xs text-neutral-300">
            Get an exact campaign strategy and keyword architecture designed for your business.
          </span>
        </div>

        <a
          href={`${SITE_CONFIG.whatsappUrl}?text=${whatsappMessage}`}
          target="_blank"
          rel="noreferrer"
          className="w-full sm:w-auto py-2.5 px-5 rounded-xl bg-brand-teal hover:bg-brand-teal-hover text-white font-semibold text-xs transition flex items-center justify-center gap-2 shrink-0 shadow-sm"
        >
          <MessageSquare className="w-4 h-4" />
          <span>Discuss on WhatsApp</span>
          <ArrowRight className="w-3.5 h-3.5" />
        </a>
      </div>
    </div>
  );
}
