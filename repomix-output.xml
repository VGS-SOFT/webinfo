<file path="components/ui/FaqAccordion.tsx">
'use client';

import React, { useState } from 'react';
import { ChevronDown } from 'lucide-react';

export interface FaqItem {
  question: string;
  answer: string;
}

interface FaqAccordionProps {
  items: FaqItem[];
  title?: string;
  description?: string;
  className?: string;
}

export function FaqAccordion({
  items,
  title = 'Frequently Asked Questions',
  description = 'Direct answers regarding technical execution, deliverables, and timelines.',
  className = '',
}: FaqAccordionProps) {
  const [openIndex, setOpenIndex] = useState<number | null>(0);

  function toggleIndex(index: number) {
    setOpenIndex(openIndex === index ? null : index);
  }

  // Schema.org FAQPage structured markup
  const faqSchema = {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: items.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  };

  return (
    <section className={`py-12 ${className}`}>
      <script
        type="application/ld+json"
        dangerouslySetInnerHTML={{ __html: JSON.stringify(faqSchema) }}
      />
      <div className="text-center max-w-2xl mx-auto mb-8">
        <h2 className="text-2xl sm:text-3xl font-bold tracking-tight text-ink">{title}</h2>
        <p className="text-sm text-ink-muted mt-2">{description}</p>
      </div>

      <div className="max-w-3xl mx-auto space-y-3">
        {items.map((item, index) => {
          const isOpen = openIndex === index;
          return (
            <div
              key={index}
              className={`rounded-2xl border transition-all duration-200 overflow-hidden ${
                isOpen
                  ? 'border-brand-teal/50 bg-white shadow-subtle ring-1 ring-brand-teal/20'
                  : 'border-neutral-200/80 bg-white/70 hover:border-neutral-300'
              }`}
            >
              <button
                type="button"
                onClick={() => toggleIndex(index)}
                aria-expanded={isOpen}
                className="w-full text-left p-4 sm:p-5 flex items-center justify-between gap-4 font-semibold text-sm sm:text-base text-ink"
              >
                <span>{item.question}</span>
                <ChevronDown
                  className={`w-4 h-4 text-brand-teal shrink-0 transition-transform duration-200 ${
                    isOpen ? 'rotate-180' : ''
                  }`}
                />
              </button>

              {isOpen && (
                <div className="px-4 sm:px-5 pb-5 pt-1 text-ink-muted text-xs sm:text-sm leading-relaxed border-t border-neutral-100">
                  {item.answer}
                </div>
              )}
            </div>
          );
        })}
      </div>
    </section>
  );
}
</file>

