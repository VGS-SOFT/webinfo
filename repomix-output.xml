<file path="middleware.ts">
import { NextResponse } from 'next/server';
import type { NextRequest } from 'next/server';
import { ADMIN_COOKIE_NAME } from '@/lib/constants';

export function middleware(request: NextRequest) {
  const { pathname } = request.nextUrl;

  // Paths exempt from admin auth check
  const isLoginPage = pathname === '/iamadmin/login' || pathname === '/iamadmin/login/';
  const isLoginApi = pathname === '/api/admin/auth/login' || pathname === '/api/admin/auth/login/';

  const isAdminRoute = pathname.startsWith('/iamadmin');
  const isAdminApiRoute = pathname.startsWith('/api/admin');

  // If it is not an admin route or is an auth login endpoint, proceed
  if ((!isAdminRoute && !isAdminApiRoute) || isLoginPage || isLoginApi) {
    return NextResponse.next();
  }

  // Check for admin session cookie
  const token = request.cookies.get(ADMIN_COOKIE_NAME)?.value;

  if (!token) {
    if (isAdminApiRoute) {
      return NextResponse.json(
        {
          success: false,
          error: {
            code: 'UNAUTHORIZED',
            message: 'Authentication token is missing or expired.',
          },
        },
        { status: 401 }
      );
    }

    // Redirect to login page with return URL
    const loginUrl = new URL('/iamadmin/login/', request.url);
    loginUrl.searchParams.set('redirect', pathname);
    return NextResponse.redirect(loginUrl);
  }

  return NextResponse.next();
}

export const config = {
  matcher: ['/iamadmin/:path*', '/api/admin/:path*'],
};
</file>

