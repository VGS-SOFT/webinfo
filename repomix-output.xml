import { NextRequest, NextResponse } from 'next/server';
import { connectToDatabase } from '@/lib/db';
import { Media } from '@/models/Media';
import { uploadToCloudinary } from '@/lib/cloudinary';

export async function GET() {
  try {
    await connectToDatabase();
    const media = await Media.find().sort({ createdAt: -1 }).lean();
    return NextResponse.json({ success: true, data: media });
  } catch (error) {
    console.error('Fetch media error:', error);
    return NextResponse.json(
      { success: false, error: { code: 'SERVER_ERROR', message: 'Failed to fetch media assets' } },
      { status: 500 }
    );
  }
}

export async function POST(req: NextRequest) {
  try {
    const formData = await req.formData();
    const file = formData.get('file') as File | null;
    const altText = (formData.get('altText') as string) || '';
    const caption = (formData.get('caption') as string) || '';
    const tagsRaw = (formData.get('tags') as string) || '';

    if (!file) {
      return NextResponse.json(
        { success: false, error: { code: 'MISSING_FILE', message: 'No file provided' } },
        { status: 400 }
      );
    }

    if (!altText.trim()) {
      return NextResponse.json(
        { success: false, error: { code: 'MISSING_ALT', message: 'Alt text is mandatory for accessibility' } },
        { status: 400 }
      );
    }

    const bytes = await file.arrayBuffer();
    const buffer = Buffer.from(bytes);

    const uploadResult = await uploadToCloudinary(
      buffer,
      'vrajvithalani/production',
      file.name.replace(/\.[^/.]+$/, '')
    );

    await connectToDatabase();
    const mediaRecord = await Media.create({
      publicId: uploadResult.public_id,
      secureUrl: uploadResult.secure_url,
      format: uploadResult.format,
      width: uploadResult.width,
      height: uploadResult.height,
      bytes: uploadResult.bytes,
      altText: altText.trim(),
      caption: caption.trim(),
      tags: tagsRaw ? tagsRaw.split(',').map((t) => t.trim()) : [],
      folder: 'vrajvithalani/production',
      uploadedBy: 'admin',
    });

    return NextResponse.json(
      {
        success: true,
        message: 'Asset uploaded and registered successfully',
        data: mediaRecord,
      },
      { status: 201 }
    );
  } catch (error) {
    console.error('Media upload error:', error);
    return NextResponse.json(
      { success: false, error: { code: 'UPLOAD_FAILED', message: 'Failed to process media upload' } },
      { status: 500 }
    );
  }
}
</file>

