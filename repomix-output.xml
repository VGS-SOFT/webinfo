              <X className="w-4 h-4" />
            </button>
          </div>

          {/* Navigation Links */}
          <nav className="mt-4 space-y-1">
            <Link
              href="/"
              onClick={onClose}
              className={`block px-3 py-2 rounded-xl text-xs font-bold ${
                pathname === '/' ? 'bg-brand-teal-tint text-brand-teal-dark' : 'text-ink hover:bg-canvas-soft'
