<file path="app/iamadmin/leads/page.tsx">
'use client';

import React, { useState, useEffect, useCallback } from 'react';
import {
  Search,
  Filter,
  Trash2,
  MessageSquare,
  Clock,
  Mail,
  Phone,
  Tag,
  DollarSign,
  Loader2,
  Send,
  X,
  Inbox,
} from 'lucide-react';
import { ILead, LeadStatus } from '@/types/lead';

const STATUS_OPTIONS: { label: string; value: LeadStatus | 'all'; color: string }[] = [
  { label: 'All Leads', value: 'all', color: 'bg-neutral-100 text-neutral-800' },
  { label: 'New', value: 'new', color: 'bg-emerald-50 text-emerald-700 border-emerald-200' },
  { label: 'Contacted', value: 'contacted', color: 'bg-blue-50 text-blue-700 border-blue-200' },
  { label: 'In Pipeline', value: 'in_pipeline', color: 'bg-amber-50 text-amber-700 border-amber-200' },
  { label: 'Closed', value: 'closed', color: 'bg-teal-50 text-teal-800 border-teal-200' },
  { label: 'Archived', value: 'archived', color: 'bg-neutral-100 text-neutral-600 border-neutral-200' },
];

export default function AdminLeadsPage() {
  const [leads, setLeads] = useState<ILead[]>([]);
  const [loading, setLoading] = useState(true);
  const [selectedStatus, setSelectedStatus] = useState<LeadStatus | 'all'>('all');
  const [search, setSearch] = useState('');
  const [activeLead, setActiveLead] = useState<ILead | null>(null);
  const [newNoteText, setNewNoteText] = useState('');
  const [submittingNote, setSubmittingNote] = useState(false);
  const [deleteConfirmId, setDeleteConfirmId] = useState<string | null>(null);

  const fetchLeads = useCallback(async () => {
    setLoading(true);
    try {
      const params = new URLSearchParams();
      if (selectedStatus !== 'all') params.set('status', selectedStatus);
      if (search.trim()) params.set('search', search.trim());

      const res = await fetch(`/api/admin/leads?${params.toString()}`);
      const data = await res.json();
      if (data.success) {
        setLeads(data.items);
      }
    } catch (err) {
      console.error('Failed to load leads:', err);
    } finally {
      setLoading(false);
    }
  }, [selectedStatus, search]);

  useEffect(() => {
    const debounce = setTimeout(() => {
      fetchLeads();
    }, 300);
    return () => clearTimeout(debounce);
  }, [fetchLeads]);

  async function handleStatusChange(leadId: string, newStatus: LeadStatus) {
    try {
      const res = await fetch(`/api/admin/leads/${leadId}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ status: newStatus }),
      });
      const data = await res.json();
      if (data.success) {
        setLeads((prev) =>
          prev.map((l) => (l._id === leadId ? { ...l, status: newStatus } : l))
        );
        if (activeLead && activeLead._id === leadId) {
          setActiveLead({ ...activeLead, status: newStatus });
        }
      }
    } catch (err) {
      console.error('Failed to update status:', err);
    }
  }

  async function handleAddNote(e: React.FormEvent) {
    e.preventDefault();
    if (!activeLead || !newNoteText.trim()) return;

    setSubmittingNote(true);
    try {
      const res = await fetch(`/api/admin/leads/${activeLead._id}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          status: activeLead.status,
          note: { author: 'Vraj', text: newNoteText.trim() },
        }),
      });
      const data = await res.json();
      if (data.success) {
        setActiveLead(data.data);
        setLeads((prev) => prev.map((l) => (l._id === data.data._id ? data.data : l)));
        setNewNoteText('');
      }
    } catch (err) {
      console.error('Failed to add note:', err);
    } finally {
      setSubmittingNote(false);
    }
  }

  async function handleDeleteLead(leadId: string) {
    try {
      const res = await fetch(`/api/admin/leads/${leadId}`, { method: 'DELETE' });
      const data = await res.json();
      if (data.success) {
        setLeads((prev) => prev.filter((l) => l._id !== leadId));
        if (activeLead && activeLead._id === leadId) {
          setActiveLead(null);
        }
        setDeleteConfirmId(null);
      }
    } catch (err) {
      console.error('Failed to delete lead:', err);
    }
  }

  return (
    <div className="space-y-6">
      {/* Header & Controls */}
      <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <h1 className="text-2xl font-bold tracking-tight text-ink">Lead Pipeline CRM</h1>
          <p className="text-sm text-ink-muted">Manage, qualify, and track direct inbound inquiries</p>
        </div>

        {/* Search */}
        <div className="relative w-full sm:w-72">
          <Search className="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-neutral-400" />
          <input
            type="text"
            value={search}
            onChange={(e) => setSearch(e.target.value)}
            placeholder="Search leads by name, email, phone..."
            className="w-full pl-9 pr-4 py-2 rounded-xl border border-neutral-200 bg-white text-ink text-xs focus:border-brand-teal focus:ring-2 focus:ring-brand-teal/20 outline-none"
          />
        </div>
      </div>

      {/* Filter Tabs */}
      <div className="flex items-center gap-1.5 overflow-x-auto pb-1">
        <Filter className="w-3.5 h-3.5 text-neutral-400 mr-1 shrink-0" />
        {STATUS_OPTIONS.map((opt) => (
          <button
            key={opt.value}
            onClick={() => setSelectedStatus(opt.value)}
            className={`px-3 py-1.5 rounded-lg text-xs font-medium whitespace-nowrap transition border ${
              selectedStatus === opt.value
                ? 'bg-ink text-white border-ink'
                : 'bg-white text-ink-muted hover:text-ink border-neutral-200'
            }`}
          >
            {opt.label}
          </button>
        ))}
      </div>

      {/* Leads Grid / Table */}
      {loading ? (
        <div className="py-20 flex flex-col items-center justify-center text-ink-muted gap-2">
          <Loader2 className="w-6 h-6 animate-spin text-brand-teal" />
          <span className="text-xs">Loading inquiries...</span>
        </div>
      ) : leads.length === 0 ? (
        <div className="glass-card rounded-2xl p-12 text-center text-ink-muted">
          <Inbox className="w-10 h-10 mx-auto mb-3 text-neutral-300" />
          <p className="text-sm font-medium">No lead inquiries found.</p>
          <p className="text-xs text-ink-subtle mt-1">
            New contact submissions will automatically appear here.
          </p>
        </div>
      ) : (
        <div className="grid grid-cols-1 lg:grid-cols-3 gap-6">
          {/* Leads List */}
          <div className="lg:col-span-2 space-y-3">
            {leads.map((lead) => {
              const statusCfg = STATUS_OPTIONS.find((s) => s.value === lead.status);
              const isSelected = activeLead?._id === lead._id;

              return (
                <div
                  key={lead._id}
                  onClick={() => setActiveLead(lead)}
                  className={`glass-card rounded-xl p-4 border transition cursor-pointer ${
                    isSelected
                      ? 'border-brand-teal shadow-md ring-1 ring-brand-teal/20 bg-white'
                      : 'border-neutral-200/80 hover:border-neutral-300 bg-white/70'
                  }`}
                >
                  <div className="flex items-start justify-between gap-3">
                    <div>
                      <div className="flex items-center gap-2">
                        <span className="font-semibold text-sm text-ink">{lead.fullName}</span>
                        <span
                          className={`text-[10px] font-medium px-2 py-0.5 rounded-full border ${
                            statusCfg?.color || 'bg-neutral-100 text-neutral-700'
                          }`}
                        >
                          {statusCfg?.label || lead.status}
                        </span>
                      </div>

                      <div className="flex flex-wrap items-center gap-x-4 gap-y-1 mt-2 text-xs text-ink-muted">
                        <span className="flex items-center gap-1">
                          <Mail className="w-3 h-3 text-neutral-400" />
                          <a href={`mailto:${lead.email}`} className="hover:text-brand-teal">
                            {lead.email}
                          </a>
                        </span>
                        <span className="flex items-center gap-1">
                          <Phone className="w-3 h-3 text-neutral-400" />
                          <a href={`tel:${lead.phone}`} className="hover:text-brand-teal">
                            {lead.phone}
                          </a>
                        </span>
                        <span className="flex items-center gap-1">
                          <Tag className="w-3 h-3 text-neutral-400" />
                          {lead.service}
                        </span>
                        <span className="flex items-center gap-1">
                          <DollarSign className="w-3 h-3 text-neutral-400" />
                          {lead.monthlyBudget}
                        </span>
                      </div>
                    </div>

                    <div className="text-[11px] text-ink-subtle whitespace-nowrap flex items-center gap-1">
                      <Clock className="w-3 h-3" />
                      {new Date(lead.createdAt).toLocaleDateString()}
                    </div>
                  </div>

                  {lead.message && (
                    <p className="text-xs text-ink-muted mt-3 line-clamp-2 bg-neutral-50 p-2.5 rounded-lg border border-neutral-100">
                      &quot;{lead.message}&quot;
                    </p>
                  )}
                </div>
              );
            })}
          </div>

          {/* Lead Detail & Notes Drawer */}
          <div className="lg:col-span-1">
            {activeLead ? (
              <div className="glass-card rounded-2xl p-5 border border-neutral-200/80 bg-white sticky top-20 space-y-5">
                <div className="flex items-start justify-between">
                  <div>
                    <h3 className="font-bold text-base text-ink">{activeLead.fullName}</h3>
                    <p className="text-xs text-ink-muted">Source: {activeLead.pageSource || '/'}</p>
                  </div>
                  <button
                    onClick={() => setActiveLead(null)}
                    className="p-1 rounded-lg text-neutral-400 hover:text-ink lg:hidden"
                  >
                    <X className="w-4 h-4" />
                  </button>
                </div>

                {/* Status Switcher */}
                <div>
                  <label className="block text-[11px] font-semibold uppercase tracking-wider text-ink-muted mb-1.5">
                    Pipeline Status
                  </label>
                  <select
                    value={activeLead.status}
                    onChange={(e) =>
                      handleStatusChange(activeLead._id, e.target.value as LeadStatus)
                    }
                    className="w-full px-3 py-2 rounded-xl border border-neutral-200 bg-white text-xs font-medium text-ink focus:border-brand-teal focus:ring-2 focus:ring-brand-teal/20 outline-none"
                  >
                    <option value="new">New Inquiry</option>
                    <option value="contacted">Contacted</option>
                    <option value="in_pipeline">In Pipeline</option>
                    <option value="closed">Closed / Won</option>
                    <option value="archived">Archived</option>
                  </select>
                </div>

                {/* Direct Action Links */}
                <div className="grid grid-cols-2 gap-2 pt-1">
                  <a
                    href={`https://wa.me/${activeLead.phone.replace(/[^0-9]/g, '')}`}
                    target="_blank"
                    rel="noreferrer"
                    className="py-2 px-3 rounded-xl bg-emerald-500 hover:bg-emerald-600 text-white font-medium text-xs text-center transition flex items-center justify-center gap-1.5 shadow-sm"
                  >
                    <span>WhatsApp</span>
                  </a>
                  <a
                    href={`mailto:${activeLead.email}`}
                    className="py-2 px-3 rounded-xl bg-neutral-900 hover:bg-black text-white font-medium text-xs text-center transition flex items-center justify-center gap-1.5 shadow-sm"
                  >
                    <span>Send Email</span>
                  </a>
                </div>

                {/* Internal Notes History */}
                <div className="pt-2 border-t border-neutral-100">
                  <h4 className="text-xs font-semibold text-ink flex items-center gap-1.5 mb-3">
                    <MessageSquare className="w-3.5 h-3.5 text-brand-teal" />
                    <span>Internal Notes ({activeLead.notes?.length || 0})</span>
                  </h4>

                  <div className="space-y-2 max-h-48 overflow-y-auto pr-1">
                    {activeLead.notes && activeLead.notes.length > 0 ? (
                      activeLead.notes.map((note, idx) => (
                        <div key={idx} className="p-2.5 rounded-lg bg-neutral-50 text-xs border border-neutral-100">
                          <div className="flex items-center justify-between text-[10px] text-ink-subtle mb-1">
                            <span className="font-semibold text-ink">{note.author}</span>
                            <span>{new Date(note.createdAt).toLocaleString()}</span>
                          </div>
                          <p className="text-ink-muted">{note.text}</p>
                        </div>
                      ))
                    ) : (
                      <p className="text-[11px] text-ink-subtle italic">No notes logged yet.</p>
                    )}
                  </div>

                  {/* Add Note Form */}
                  <form onSubmit={handleAddNote} className="mt-3 flex gap-2">
                    <input
                      type="text"
                      value={newNoteText}
                      onChange={(e) => setNewNoteText(e.target.value)}
                      placeholder="Add an internal note..."
                      className="flex-1 px-3 py-1.5 rounded-xl border border-neutral-200 text-xs text-ink focus:border-brand-teal outline-none"
