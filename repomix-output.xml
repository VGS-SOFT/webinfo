import { NextRequest, NextResponse } from 'next/server';
import { connectToDatabase } from '@/lib/db';
import { AdminUser } from '@/models/AdminUser';
import { AdminLoginSchema } from '@/lib/validations/admin';
import { verifyPassword, signAdminToken } from '@/lib/auth';
import { rateLimit } from '@/lib/rate-limit';
import { ADMIN_COOKIE_NAME, ADMIN_SESSION_DURATION } from '@/lib/constants';

export async function POST(req: NextRequest) {
  try {
    const ip =
      req.headers.get('x-forwarded-for')?.split(',')[0]?.trim() ||
      req.headers.get('x-real-ip') ||
      '127.0.0.1';

    const { isLimited } = rateLimit(`admin_login_${ip}`, { limit: 5, windowMs: 15 * 60 * 1000 });
    if (isLimited) {
      return NextResponse.json(
        {
          success: false,
          error: {
            code: 'TOO_MANY_ATTEMPTS',
            message: 'Too many failed login attempts. Please try again after 15 minutes.',
          },
        },
        { status: 429 }
      );
    }

    const body = await req.json();
    const validationResult = AdminLoginSchema.safeParse(body);

    if (!validationResult.success) {
      return NextResponse.json(
        {
          success: false,
          error: {
            code: 'VALIDATION_ERROR',
            message: 'Invalid credentials format.',
          },
        },
        { status: 400 }
      );
    }

    const { username, password } = validationResult.data;

    await connectToDatabase();
    const admin = await AdminUser.findOne({
      $or: [{ username: username.toLowerCase() }, { email: username.toLowerCase() }],
    });

    if (!admin) {
      return NextResponse.json(
        {
          success: false,
          error: {
            code: 'INVALID_CREDENTIALS',
            message: 'Invalid username or password.',
          },
        },
        { status: 401 }
      );
    }

    const isPasswordValid = await verifyPassword(password, admin.passwordHash);
    if (!isPasswordValid) {
      return NextResponse.json(
        {
          success: false,
          error: {
            code: 'INVALID_CREDENTIALS',
            message: 'Invalid username or password.',
          },
        },
        { status: 401 }
      );
    }

    // Update lastLogin timestamp
    admin.lastLogin = new Date();
    await admin.save();

    // Sign JWT Token
    const token = signAdminToken({
      sub: admin._id.toString(),
      username: admin.username,
      role: admin.role,
      tokenVersion: admin.tokenVersion,
    });

    const response = NextResponse.json({
      success: true,
      data: {
        username: admin.username,
        email: admin.email,
        role: admin.role,
      },
    });

    // Set HttpOnly, Secure, SameSite=Strict cookie
    response.cookies.set({
      name: ADMIN_COOKIE_NAME,
      value: token,
      httpOnly: true,
      secure: process.env.NODE_ENV === 'production',
      sameSite: 'strict',
      maxAge: ADMIN_SESSION_DURATION,
      path: '/',
    });

    return response;
  } catch (error) {
    console.error('Admin login error:', error);
    return NextResponse.json(
      {
        success: false,
        error: {
          code: 'INTERNAL_SERVER_ERROR',
          message: 'Authentication failed due to a server error.',
        },
      },
      { status: 500 }
    );
  }
}
</file>

